#usda 1.0
(
    defaultPrim = "World"
)

def Xform "World" {
    def "Cube" (
        kind = "component"
    ) {
        def Cube "Mesh" {
            double size = 2.0
            float3 xformOp:translate = (0, 1, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def "Sphere" (
        kind = "component"
    ) {
        def Sphere "Mesh" {
            double radius = 1.0
            float3 xformOp:translate = (3, 1, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Camera "MainCamera" {
        float2 clippingRange = (0.1, 1000)
        float focalLength = 35
        float3 xformOp:translate = (2, 3, 8)
        float3 xformOp:rotateXYZ = (-15, 10, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def DomeLight "DomeLight" {
        float inputs:intensity = 0.5
    }

    def DistantLight "KeyLight" {
        float inputs:intensity = 5.0
        float3 xformOp:rotateXYZ = (-45, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
}
